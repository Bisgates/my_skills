#!/usr/bin/env bash
# Use the fabu Codex profile on either a workstation or a remote Linux host.
set -u

CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
CONFIG_FILE="$CODEX_HOME/fabu.config.toml"
DEFAULT_HOST="crs.fabu.ai"
CODEX_BIN=""

find_codex() {
  CODEX_BIN="$(command -v codex 2>/dev/null || true)"
  if [ -z "$CODEX_BIN" ] && [ -x "$HOME/.npm-global/bin/codex" ]; then
    CODEX_BIN="$HOME/.npm-global/bin/codex"
  fi
}

catalog_path() {
  local path
  path="$CODEX_HOME/fabu.models.json"
  if [ -r "$CONFIG_FILE" ]; then
    path="$(sed -n 's/^[[:space:]]*model_catalog_json[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$CONFIG_FILE" | head -1)"
    [ -n "$path" ] || path="$CODEX_HOME/fabu.models.json"
    case "$path" in
      /*) ;;
      *) path="$CODEX_HOME/$path" ;;
    esac
  fi
  printf '%s\n' "$path"
}

auth_env_name() {
  if [ -r "$CONFIG_FILE" ]; then
    sed -n 's/^[[:space:]]*env_key[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$CONFIG_FILE" | head -1
  fi
}

reachable() {
  local host url
  host="${FABUX_PREFLIGHT_HOST:-$DEFAULT_HOST}"
  url="${FABUX_PREFLIGHT_URL:-http://$host/openai}"
  if command -v curl >/dev/null 2>&1; then
    curl --noproxy "$host" --connect-timeout 3 --max-time 3 -sS -o /dev/null "$url" >/dev/null 2>&1
    return $?
  fi
  if command -v nc >/dev/null 2>&1; then
    nc -z -w 3 "$host" 80 >/dev/null 2>&1
    return $?
  fi
  return 127
}

preflight() {
  [ "${FABUX_SKIP_PREFLIGHT:-0}" = "1" ] && return 0
  if reachable; then
    return 0
  fi
  echo "fabux: ${FABUX_PREFLIGHT_HOST:-$DEFAULT_HOST} unreachable — connect to the fabu network (VPN/office). Off-site use plain codex (personal quota)." >&2
  return 3
}

print_models() {
  local catalog
  catalog="$(catalog_path)"
  if [ ! -r "$catalog" ]; then
    echo "fabux: catalog missing: $catalog" >&2
    return 1
  fi
  printf 'slug\tdisplay name\tdefault effort\n'
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$catalog" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as stream:
    data = json.load(stream)
models = data if isinstance(data, list) else data.get("models", [])
for model in models:
    slug = model.get("slug", "")
    if slug:
        print("{}\t{}\t{}".format(
            slug,
            model.get("display_name", "-"),
            model.get("default_reasoning_level", "-"),
        ))
PY
    return $?
  fi
  awk '
    function value(line) {
      sub(/.*:[[:space:]]*"/, "", line)
      sub(/".*/, "", line)
      return line
    }
    /"slug"[[:space:]]*:/ { slug = value($0) }
    /"display_name"[[:space:]]*:/ { name = value($0) }
    /"default_reasoning_level"[[:space:]]*:/ {
      effort = value($0)
      if (slug != "") {
        print slug "\t" name "\t" effort
        slug = name = effort = ""
      }
    }
  ' "$catalog"
}

doctor() {
  local failures version key catalog host
  failures=0
  find_codex

  if [ -n "$CODEX_BIN" ]; then
    version="$("$CODEX_BIN" --version 2>&1 | head -1)"
    if [ -n "$version" ]; then
      echo "PASS codex binary/version: $CODEX_BIN ($version)"
    else
      echo "FAIL codex binary/version: cannot read version — reinstall Codex or fix PATH"
      failures=1
    fi
  else
    echo "FAIL codex binary/version: codex not found — install Codex or add it to PATH"
    failures=1
  fi

  if [ -r "$CONFIG_FILE" ]; then
    echo "PASS fabu profile: $CONFIG_FILE"
  else
    echo "FAIL fabu profile: $CONFIG_FILE missing — create it from references/setup.md"
    failures=1
  fi

  key="$(auth_env_name)"
  if [ -n "$key" ]; then
    if [ -n "$(printenv "$key" 2>/dev/null)" ]; then
      echo "PASS auth: $key is set"
    else
      echo "FAIL auth: $key is unset or empty — export the gateway key before running fabux"
      failures=1
    fi
  elif [ -r "$CODEX_HOME/auth.json" ]; then
    echo "PASS auth: $CODEX_HOME/auth.json"
  else
    echo "FAIL auth: $CODEX_HOME/auth.json missing — log in or restore auth.json"
    failures=1
  fi

  catalog="$(catalog_path)"
  if [ -r "$catalog" ]; then
    echo "PASS catalog: $catalog"
  else
    echo "FAIL catalog: $catalog missing — install fabu.models.json"
    failures=1
  fi

  host="${FABUX_PREFLIGHT_HOST:-$DEFAULT_HOST}"
  if reachable; then
    echo "PASS $host: reachable within 3s (direct/no-proxy preflight)"
  else
    echo "FAIL $host: unreachable — connect to the fabu network (VPN/office)"
    failures=1
  fi
  return "$failures"
}

find_codex

case "${1:-}" in
  models)
    [ "$#" -eq 1 ] || { echo "fabux: models takes no arguments" >&2; exit 2; }
    print_models
    exit $?
    ;;
  doctor)
    [ "$#" -eq 1 ] || { echo "fabux: doctor takes no arguments" >&2; exit 2; }
    doctor
    exit $?
    ;;
esac

preflight || exit $?
[ -n "$CODEX_BIN" ] || { echo "fabux: codex not found — install Codex or add it to PATH" >&2; exit 127; }
exec "$CODEX_BIN" --profile fabu "$@"
