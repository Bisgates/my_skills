#!/usr/bin/env python3
"""arc — task management CLI (Arc Protocol).

Single-file Python (stdlib only). Spec: ~/.claude/skills/arc/SKILL.md.
"""
from __future__ import annotations

import argparse
import datetime as dt
import os
import re
import shutil
import sys
from pathlib import Path
from typing import Dict, List, Optional, Tuple

ARCS_DIRNAME = "arcs"
ALL_DIRNAME = "all"
STATES = ("active", "paused", "done", "abandoned")
ID_RE = re.compile(r"^(\d{6})([a-z])$")
ID_CHARS = "abcdefghijklmnopqrstuvwxyz"
META_FIELDS = (
    "id",
    "brief",
    "created_at",
    "last_active_at",
    "status",
    "actor",
    "parent",
    "abandon_reason",
)

AGENTS_HOOK = """
## Arc Protocol
- 任务管理协议：~/.claude/skills/arc/SKILL.md。
- **arc 目录是唯一写入面**：任务期间 agent 只写 `arcs/<id>_*/`，主项目目录只读；落盘由用户手动执行。
- agent **不主动**读 arcs/index.md；仅在用户显式触发 /arc-* 或 `arc <subcmd>` CLI 时进入任务流程。
- 触发 skill：/arc-new, /arc-objective, /arc-plan, /arc-execute, /arc-resume, /arc-spawn, /arc-finalize。
- 触发 CLI：arc {new,spawn,pause,resume,status,abandon,delete,touch,log,output,list,cd,rebuild,init}。
- ID 永远 7 字符 YYMMDDx；canonical 路径 `arcs/<id>_*` 或 `arcs/<track>/<id>_*`（track 只改放置位置）；状态权威在 `0_meta.md`。
- 文件：`1_objective.md` 目标 / `2_plan.md` 路线 / `3_state.md` 活的状态快照（覆写）/ `9_handoff.md` 结论+落盘清单。
- `done` 必须存在 `9_handoff.md`；`abandoned` 必须有 `--reason`；`delete` 是硬删（不留 trace）。
"""


# ---------- helpers ----------

def now_iso() -> str:
    return dt.datetime.now().astimezone().replace(microsecond=0).isoformat()


def now_human() -> str:
    """Human-readable local timestamp for log entries.

    Format: ``YYYY-MM-DD HH:MM:SS`` (no ``T``, no timezone).
    Used only by ``arc log`` body — frontmatter still uses ISO 8601.
    """
    return dt.datetime.now().strftime("%Y-%m-%d %H:%M:%S")


def today_id() -> str:
    return dt.datetime.now().strftime("%y%m%d")


def err(msg: str) -> None:
    print(f"arc: {msg}", file=sys.stderr)


def die(msg: str, code: int = 1) -> None:
    err(msg)
    sys.exit(code)


def find_project_root(start: Optional[Path] = None) -> Optional[Path]:
    p = (start or Path.cwd()).resolve()
    while True:
        if (p / ARCS_DIRNAME).is_dir():
            return p
        if p.parent == p:
            return None
        p = p.parent


def require_root() -> Path:
    root = find_project_root()
    if root is None:
        die("not initialized in this directory tree. Run: arc init")
    return root


def slugify_brief(brief: str, max_words: int = 5) -> str:
    s = re.sub(r"[^A-Za-z0-9]+", "_", brief.strip().lower()).strip("_")
    parts = [w for w in s.split("_") if w]
    if not parts:
        die("brief is empty after normalization.")
    if len(parts) > max_words:
        parts = parts[:max_words]
    return "_".join(parts)


def _is_arc_dir(path: Path) -> bool:
    if not path.is_dir() or not (path / "0_meta.md").exists():
        return False
    return bool(ID_RE.match(path.name.split("_", 1)[0]))


def iter_arc_dirs(root: Path) -> List[Path]:
    """Arc dirs at `arcs/<id>_*` and one level down at `arcs/<track>/<id>_*`."""
    base = root / ARCS_DIRNAME
    if not base.is_dir():
        return []
    out: List[Path] = []
    for child in sorted(base.iterdir()):
        if _is_arc_dir(child):
            out.append(child)
        elif child.is_dir() and child.name != ALL_DIRNAME:
            for grandchild in sorted(child.iterdir()):
                if _is_arc_dir(grandchild):
                    out.append(grandchild)
    return out


def split_track(words: List[str]) -> Tuple[List[str], Optional[str]]:
    """Pull a trailing `track <name>` off the brief. Placement only."""
    if len(words) >= 2 and words[-2] == "track":
        name = words[-1]
        if not name or name in (".", "..") or "/" in name or "\\" in name:
            die(f"invalid track name {name!r}.")
        reserved = {ALL_DIRNAME, "index.md", *STATES}
        if name in reserved:
            die(f"track name {name!r} is reserved.")
        if ID_RE.match(name.split("_", 1)[0]):
            die(f"track name {name!r} looks like an arc id.")
        return words[:-2], name
    if words and words[-1] == "track":
        die("track requires a name (e.g. arc new fix pipeline track data_process).")
    return words, None


def next_letter(root: Path, day: str) -> str:
    used = set()
    for child in iter_arc_dirs(root):
        head = child.name.split("_", 1)[0]
        m = ID_RE.match(head)
        if m and m.group(1) == day:
            used.add(m.group(2))
    for c in ID_CHARS:
        if c not in used:
            return c
    die(f"all 26 letters used for day {day}; not handling this case.")


def find_arc_dir(root: Path, arg: str) -> Path:
    """Resolve user input (7-char id, or full <id>_<slug> name) to canonical dir."""
    matches = [p for p in iter_arc_dirs(root) if p.name == arg or p.name.split("_", 1)[0] == arg]
    if len(matches) == 1:
        return matches[0]
    if len(matches) > 1:
        base = root / ARCS_DIRNAME
        names = ", ".join(str(m.relative_to(base)) for m in matches)
        die(f"multiple arcs match {arg}: {names}")
    head = arg.split("_", 1)[0]
    if not ID_RE.match(arg) and not ID_RE.match(head):
        die(f"invalid id {arg!r}. Expected 7 chars: YYMMDDx (6 digits + lowercase letter).")
    die(f"no arc found with id {arg}.")


def cwd_arc_dir(root: Path) -> Optional[Path]:
    cwd = Path.cwd().resolve()
    base = (root / ARCS_DIRNAME).resolve()
    try:
        rel = cwd.relative_to(base)
    except ValueError:
        return None
    if len(rel.parts) >= 2:
        nested = base / rel.parts[0] / rel.parts[1]
        if _is_arc_dir(nested):
            return nested
    if rel.parts:
        top = base / rel.parts[0]
        if _is_arc_dir(top):
            return top
    return None


def resolve_arc_dir(root: Path, arc_id: Optional[str]) -> Path:
    if arc_id:
        return find_arc_dir(root, arc_id)
    arc = cwd_arc_dir(root)
    if arc is None:
        die("no arc id given and cwd is not inside an arc directory.")
    return arc


# ---------- meta r/w ----------

def parse_meta(arc_dir: Path) -> Tuple[Dict[str, str], List[str], str]:
    """Parse 0_meta.md → (frontmatter, history_lines, log_body).

    log_body is the verbatim contents (without the ``## log`` header) of the
    optional ``## log`` section, preserving newlines so ``write_meta`` can
    round-trip it. Returns ``""`` when no log section is present.
    """
    p = arc_dir / "0_meta.md"
    if not p.exists():
        die(f"missing {p}.")
    text = p.read_text(encoding="utf-8")
    if not text.startswith("---\n"):
        die(f"0_meta.md missing frontmatter: {p}.")
    try:
        end = text.index("\n---\n", 4)
    except ValueError:
        die(f"0_meta.md frontmatter not closed: {p}.")
    fm_text = text[4:end]
    body = text[end + 5:]
    fm: Dict[str, str] = {}
    for line in fm_text.splitlines():
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        if ":" in line:
            k, _, v = line.partition(":")
            fm[k.strip()] = v.strip()

    history: List[str] = []
    log_lines: List[str] = []
    section: Optional[str] = None
    for line in body.splitlines():
        stripped = line.strip().lower()
        if stripped.startswith("## history"):
            section = "history"
            continue
        if stripped.startswith("## log"):
            section = "log"
            continue
        if stripped.startswith("## "):
            section = None
            continue
        if section == "history":
            if line.startswith("- "):
                history.append(line[2:].strip())
        elif section == "log":
            log_lines.append(line)

    log_body = "\n".join(log_lines).strip("\n")
    return fm, history, log_body


def write_meta(
    arc_dir: Path,
    fm: Dict[str, str],
    history: List[str],
    log_body: str = "",
) -> None:
    lines = ["---"]
    for k in META_FIELDS:
        v = fm.get(k)
        lines.append(f"{k}: {v if v not in (None, '') else 'null'}")
    lines.append("---")
    lines.append("")
    lines.append("## history")
    for h in history:
        lines.append(f"- {h}")
    lines.append("")
    lines.append("## log")
    if log_body.strip():
        lines.append(log_body.strip("\n"))
    lines.append("")
    (arc_dir / "0_meta.md").write_text("\n".join(lines), encoding="utf-8")


def _migrate_legacy_log(arc_dir: Path) -> None:
    """One-shot migration: fold a legacy ``3_process_log.md`` into ``0_meta.md``.

    Idempotent: when ``3_process_log.md`` is absent, no-op. When present, its
    body (minus the leading ``# 3_process_log — ...`` header) is appended to
    the ``## log`` section of ``0_meta.md`` and the legacy file is deleted.
    """
    legacy = arc_dir / "3_process_log.md"
    if not legacy.exists():
        return
    raw = legacy.read_text(encoding="utf-8")
    body_lines: List[str] = []
    for line in raw.splitlines():
        if line.startswith("# 3_process_log"):
            continue
        body_lines.append(line)
    legacy_body = "\n".join(body_lines).strip("\n")

    fm, history, existing_log = parse_meta(arc_dir)
    if existing_log and legacy_body:
        merged = existing_log.rstrip() + "\n\n" + legacy_body
    else:
        merged = existing_log or legacy_body
    write_meta(arc_dir, fm, history, log_body=merged)
    legacy.unlink()


# ---------- layout migration + index ----------

def _migrate_layout(root: Path) -> None:
    """Flatten the legacy layout to the single-level form.

    Legacy: ``arcs/all/<name>/`` canonical dirs, with ``arcs/<name>`` active
    symlinks and ``arcs/{active,paused,done,abandoned}/`` view folders full of
    symlinks. New: ``arcs/<name>/`` canonical dirs and nothing else (besides
    ``index.md``). Idempotent — fast-returns once the tree is already flat.
    Runs only on ``arc init`` and on arc creation (``new`` / ``spawn``): those
    are the moments a tree is being touched deliberately, so an old tree
    flattens the next time real work starts in it, and read-only commands
    never rewrite a tree behind the user's back.

    Only the old *active view* links (target ``all/<name>``) are removed. A
    hand-made cross-tree reference symlink (absolute or ``../`` target — e.g.
    surfacing a sub-project's arc in the parent list) is left untouched, so
    the migration never eats a link the user placed on purpose.
    """
    arcs = root / ARCS_DIRNAME
    if not arcs.is_dir():
        return
    legacy_all = arcs / ALL_DIRNAME
    state_dirs = [arcs / s for s in STATES]

    def is_legacy_active_link(link: Path) -> bool:
        if not link.is_symlink():
            return False
        try:
            tgt = os.readlink(link)
        except OSError:
            return False
        return tgt.startswith(f"{ALL_DIRNAME}/")

    legacy_links = [c for c in arcs.iterdir() if is_legacy_active_link(c)]
    if not legacy_all.is_dir() and not any(d.exists() for d in state_dirs) and not legacy_links:
        return

    # 1. Drop the old active view symlinks (arcs/<name> -> all/<name>).
    for link in legacy_links:
        link.unlink()

    # 2. Drop the state view folders (they only ever hold symlinks).
    for d in state_dirs:
        if d.is_symlink():
            d.unlink()
        elif d.is_dir():
            for c in list(d.iterdir()):
                if c.is_symlink() or c.is_file():
                    c.unlink()
                elif c.is_dir():
                    shutil.rmtree(c)
            try:
                d.rmdir()
            except OSError:
                pass

    # 3. Lift arcs/all/<name>/ up to arcs/<name>/.
    if legacy_all.is_dir():
        for child in list(legacy_all.iterdir()):
            dest = arcs / child.name
            if dest.exists():
                err(f"migrate: {dest} already exists; left {child} under all/.")
                continue
            child.rename(dest)
        try:
            legacy_all.rmdir()
        except OSError:
            err(f"migrate: {legacy_all} not empty; left in place.")


def list_arcs(root: Path) -> List[Tuple[Path, Dict[str, str]]]:
    out = []
    for child in iter_arc_dirs(root):
        try:
            fm, _, _ = parse_meta(child)
        except SystemExit:
            continue
        out.append((child, fm))
    return out


def nonempty(arc: Path, name: str) -> bool:
    f = arc / name
    return f.is_file() and f.stat().st_size > 0


def still_skeleton(arc: Path, name: str) -> bool:
    """True when a template copy still carries unfilled ``<FILL:`` markers."""
    f = arc / name
    try:
        return "<FILL" in f.read_text(encoding="utf-8")
    except OSError:
        return False


def hint_for(arc: Path, fm: Dict[str, str]) -> str:
    if not nonempty(arc, "1_objective.md"):
        return "needs 1_objective.md"
    if still_skeleton(arc, "1_objective.md"):
        return "1_objective.md still has FILL markers"
    if not nonempty(arc, "2_plan.md"):
        return "needs 2_plan.md"
    if nonempty(arc, "9_handoff.md") and fm.get("status") == "active":
        return "ready to mark done"
    last = fm.get("last_active_at", "")
    try:
        last_dt = dt.datetime.fromisoformat(last)
        if (dt.datetime.now().astimezone() - last_dt).days > 7:
            return "stale, consider pause"
    except Exception:
        pass
    return "running"


def parent_id_short(parent_field: str) -> Optional[str]:
    if not parent_field or parent_field == "null":
        return None
    head = parent_field.split("_", 1)[0]
    return head if ID_RE.match(head) else None


def rebuild_index(root: Path) -> None:
    arcs_dir = root / ARCS_DIRNAME
    arcs = list_arcs(root)
    by_status: Dict[str, List[Tuple[Path, Dict[str, str]]]] = {s: [] for s in STATES}
    children_of: Dict[str, List[str]] = {}
    for arc, fm in arcs:
        by_status[fm.get("status", "active")].append((arc, fm))
        pid_short = parent_id_short(fm.get("parent", "null"))
        if pid_short:
            arc_id_short = arc.name.split("_", 1)[0]
            children_of.setdefault(pid_short, []).append(arc_id_short)

    def relations(arc_id_short: str, fm: Dict[str, str]) -> str:
        parts = []
        pid = parent_id_short(fm.get("parent", "null"))
        if pid:
            parts.append(f"child of {pid}")
        kids = sorted(children_of.get(arc_id_short, []))
        if kids:
            parts.append(f"parent of {', '.join(kids)}")
        return f" ({'; '.join(parts)})" if parts else ""

    out: List[str] = []
    out.append("<!-- AUTO-GENERATED by `arc rebuild`. Do not edit. -->")
    out.append(f"_last refreshed: {now_iso()}_")
    out.append("")

    def fmt_brief(fm: Dict[str, str], arc_id_short: str) -> str:
        return (fm.get("brief", "") or "") + relations(arc_id_short, fm)

    # Active
    rows = sorted(by_status["active"], key=lambda x: x[1].get("last_active_at", ""), reverse=True)
    out.append(f"## Active ({len(rows)})")
    if rows:
        out.append("| id | brief | created | last_active | hint |")
        out.append("|---|---|---|---|---|")
        for arc, fm in rows:
            sid = arc.name.split("_", 1)[0]
            rel = arc.relative_to(arcs_dir).as_posix()
            out.append(
                f"| [{arc.name}]({rel}) | {fmt_brief(fm, sid)} "
                f"| {fm.get('created_at', '')[:10]} "
                f"| {fm.get('last_active_at', '')[:16].replace('T', ' ')} "
                f"| {hint_for(arc, fm)} |"
            )
    out.append("")

    # Paused
    rows = sorted(by_status["paused"], key=lambda x: x[1].get("last_active_at", ""), reverse=True)
    out.append(f"## Paused ({len(rows)})")
    if rows:
        out.append("| id | brief | last_active |")
        out.append("|---|---|---|")
        for arc, fm in rows:
            sid = arc.name.split("_", 1)[0]
            rel = arc.relative_to(arcs_dir).as_posix()
            out.append(
                f"| [{arc.name}]({rel}) | {fmt_brief(fm, sid)} "
                f"| {fm.get('last_active_at', '')[:16].replace('T', ' ')} |"
            )
    out.append("")

    # Done
    rows = sorted(by_status["done"], key=lambda x: x[1].get("last_active_at", ""), reverse=True)
    out.append(f"## Done ({len(rows)})")
    if rows:
        out.append("| id | brief | done_at |")
        out.append("|---|---|---|")
        for arc, fm in rows:
            sid = arc.name.split("_", 1)[0]
            rel = arc.relative_to(arcs_dir).as_posix()
            out.append(
                f"| [{arc.name}]({rel}) | {fmt_brief(fm, sid)} "
                f"| {fm.get('last_active_at', '')[:10]} |"
            )
    out.append("")

    # Abandoned
    rows = sorted(by_status["abandoned"], key=lambda x: x[1].get("last_active_at", ""), reverse=True)
    out.append(f"## Abandoned ({len(rows)})")
    if rows:
        out.append("| id | brief | abandoned_at | reason |")
        out.append("|---|---|---|---|")
        for arc, fm in rows:
            sid = arc.name.split("_", 1)[0]
            rel = arc.relative_to(arcs_dir).as_posix()
            out.append(
                f"| [{arc.name}]({rel}) | {fmt_brief(fm, sid)} "
                f"| {fm.get('last_active_at', '')[:10]} "
                f"| {fm.get('abandon_reason', '')} |"
            )
    out.append("")

    (arcs_dir / "index.md").write_text("\n".join(out), encoding="utf-8")


# ---------- status transitions ----------

def update_status(
    arc_dir: Path,
    new_status: str,
    note: Optional[str] = None,
    reason: Optional[str] = None,
) -> Dict[str, str]:
    _migrate_legacy_log(arc_dir)
    fm, history, log_body = parse_meta(arc_dir)
    old = fm.get("status", "active")
    if old == new_status:
        die(f"arc already in status {new_status}.")
    if new_status == "done":
        if not nonempty(arc_dir, "9_handoff.md"):
            die(
                "cannot mark done: no non-empty 9_handoff.md found. "
                "(Arcs from before the handoff rename carry 9_summary.md — rename it.)"
            )
    if new_status == "abandoned":
        if not reason:
            die("--reason required for abandoned.")
        fm["abandon_reason"] = reason
    fm["status"] = new_status
    fm["last_active_at"] = now_iso()
    suffix_parts = []
    if note:
        suffix_parts.append(f"note: {note}")
    if reason:
        suffix_parts.append(f"reason: {reason}")
    suffix = f" ({'; '.join(suffix_parts)})" if suffix_parts else ""
    history.append(f"{now_iso()} {old} -> {new_status}{suffix}")
    write_meta(arc_dir, fm, history, log_body=log_body)
    return fm


# ---------- subcommands ----------

ARC_PROTOCOL_HEADER = "## Arc Protocol"


def _strip_arc_hook(content: str) -> str:
    """Remove the '## Arc Protocol' section (until next H1/H2 or EOF)."""
    lines = content.splitlines(keepends=True)
    out: List[str] = []
    skipping = False
    for line in lines:
        if line.lstrip().startswith(ARC_PROTOCOL_HEADER):
            skipping = True
            continue
        if skipping:
            stripped = line.lstrip()
            if stripped.startswith("## ") or stripped.startswith("# "):
                skipping = False
                out.append(line)
        else:
            out.append(line)
    return "".join(out).rstrip() + ("\n" if any(l.strip() for l in out) else "")


def _merge_md(primary: str, secondary: str) -> str:
    p = _strip_arc_hook(primary).rstrip()
    s = _strip_arc_hook(secondary).rstrip()
    if not p:
        return (s + "\n") if s else ""
    if not s:
        return p + "\n"
    return p + "\n\n<!-- merged from AGENTS.md -->\n\n" + s + "\n"


def _ensure_agents_claude(root: Path) -> None:
    """Ensure CLAUDE.md is the real file and AGENTS.md → CLAUDE.md.

    Migrates legacy setups where AGENTS.md was the real file (CLAUDE.md
    symlinked to it). When both are real files with diverging content,
    merges AGENTS.md into CLAUDE.md (CLAUDE.md primary).
    """
    agents = root / "AGENTS.md"
    claude = root / "CLAUDE.md"

    # Already in target shape: AGENTS.md → CLAUDE.md with CLAUDE.md a real file.
    if agents.is_symlink():
        try:
            target = os.readlink(agents)
        except OSError:
            target = ""
        if (
            target == "CLAUDE.md"
            and claude.is_file()
            and not claude.is_symlink()
        ):
            return
        # Stale/wrong-pointing symlink — drop and rebuild from whatever remains.
        agents.unlink()

    # Legacy: CLAUDE.md → AGENTS.md. Flip in place.
    if claude.is_symlink():
        try:
            target = os.readlink(claude)
        except OSError:
            target = ""
        claude.unlink()
        if (
            target == "AGENTS.md"
            and agents.is_file()
            and not agents.is_symlink()
        ):
            agents.rename(claude)
            agents.symlink_to("CLAUDE.md")
            err("migrated: renamed AGENTS.md to CLAUDE.md; symlinked AGENTS.md -> CLAUDE.md.")
            return
        # Dangling or unexpected target — fall through to real-file handling.

    a_exists = agents.is_file() and not agents.is_symlink()
    c_exists = claude.is_file() and not claude.is_symlink()

    if not a_exists and not c_exists:
        claude.write_text("", encoding="utf-8")
        agents.symlink_to("CLAUDE.md")
        err("created empty CLAUDE.md; symlinked AGENTS.md -> CLAUDE.md.")
        return

    if c_exists and not a_exists:
        agents.symlink_to("CLAUDE.md")
        err("symlinked AGENTS.md -> CLAUDE.md.")
        return

    if a_exists and not c_exists:
        agents.rename(claude)
        agents.symlink_to("CLAUDE.md")
        err("renamed AGENTS.md to CLAUDE.md; symlinked AGENTS.md -> CLAUDE.md.")
        return

    a_content = agents.read_text(encoding="utf-8")
    c_content = claude.read_text(encoding="utf-8")

    if a_content == c_content:
        agents.unlink()
        agents.symlink_to("CLAUDE.md")
        err("AGENTS.md == CLAUDE.md; symlinked AGENTS.md -> CLAUDE.md.")
        return

    merged = _merge_md(c_content, a_content)
    claude.write_text(merged, encoding="utf-8")
    agents.unlink()
    agents.symlink_to("CLAUDE.md")
    err("merged AGENTS.md into CLAUDE.md; symlinked AGENTS.md -> CLAUDE.md.")


def cmd_init(args: argparse.Namespace) -> None:
    root = Path.cwd().resolve()
    arcs = root / ARCS_DIRNAME
    fresh = not arcs.is_dir()
    arcs.mkdir(exist_ok=True)
    _migrate_layout(root)
    rebuild_index(root)
    if fresh:
        err(f"initialized {arcs}.")
    else:
        err(f"refreshed {arcs} (already initialized).")

    _ensure_agents_claude(root)

    claude = root / "CLAUDE.md"
    if claude.exists():
        content = claude.read_text(encoding="utf-8")
        if ARC_PROTOCOL_HEADER not in content:
            if content and not content.endswith("\n"):
                content += "\n"
            claude.write_text(content + AGENTS_HOOK, encoding="utf-8")
            err("appended Arc Protocol hook to CLAUDE.md.")


def _seed_state(arc_dir: Path) -> None:
    """Copy templates/3_state.md into a fresh arc.

    Seeded at creation rather than lazily so a resuming agent can always count
    on one file answering "where are we right now". If the template is missing
    (script copied out of the skill dir), skip quietly — the agent writes the
    file on first execute step anyway.
    """
    tpl = Path(__file__).resolve().parent.parent / "templates" / "3_state.md"
    try:
        (arc_dir / "3_state.md").write_text(tpl.read_text(encoding="utf-8"), encoding="utf-8")
    except OSError:
        pass


def _create_arc(args: argparse.Namespace, parent: Optional[str]) -> None:
    root = require_root()
    _migrate_layout(root)
    brief_words, track = split_track(list(args.brief))
    brief_text = " ".join(brief_words).strip()
    slug = slugify_brief(brief_text)
    day = today_id()
    letter = next_letter(root, day)
    arc_id = f"{day}{letter}"
    arc_name = f"{arc_id}_{slug}"
    parent_dir = root / ARCS_DIRNAME
    if track:
        parent_dir = parent_dir / track
        parent_dir.mkdir(exist_ok=True)
    arc_dir = parent_dir / arc_name
    arc_dir.mkdir()

    fm = {
        "id": arc_name,
        "brief": brief_text[:80],
        "created_at": now_iso(),
        "last_active_at": now_iso(),
        "status": "active",
        "actor": getattr(args, "actor", None) or "agent",
        "parent": parent or "null",
        "abandon_reason": "null",
    }
    history = [f"{now_iso()} created"]
    if parent:
        history.append(f"{now_iso()} parent set to {parent}")
    write_meta(arc_dir, fm, history)
    _seed_state(arc_dir)
    rebuild_index(root)
    print(arc_id)
    err(f"created {arc_name} at {arc_dir}.")


def cmd_new(args: argparse.Namespace) -> None:
    _create_arc(args, parent=None)


def cmd_spawn(args: argparse.Namespace) -> None:
    root = require_root()
    if args.parent:
        parent_dir = find_arc_dir(root, args.parent)
    else:
        cwd_arc = cwd_arc_dir(root)
        if cwd_arc is None:
            die("arc spawn requires --parent <id> or being run from inside an arc directory.")
        parent_dir = cwd_arc
    _create_arc(args, parent=parent_dir.name)


def cmd_pause(args: argparse.Namespace) -> None:
    root = require_root()
    arc_dir = resolve_arc_dir(root, args.id)
    update_status(arc_dir, "paused", note=args.note)
    rebuild_index(root)
    print(arc_dir.name.split("_", 1)[0])
    err(f"paused {arc_dir.name}.")


def cmd_resume(args: argparse.Namespace) -> None:
    root = require_root()
    arc_dir = resolve_arc_dir(root, args.id)
    _migrate_legacy_log(arc_dir)
    fm, history, log_body = parse_meta(arc_dir)
    old = fm.get("status", "active")
    if old != "active":
        fm["status"] = "active"
        fm["last_active_at"] = now_iso()
        history.append(f"{now_iso()} {old} -> active")
        write_meta(arc_dir, fm, history, log_body=log_body)
        rebuild_index(root)
    print(arc_dir)
    err(f"resumed {arc_dir.name} (was {old}).")


def cmd_status(args: argparse.Namespace) -> None:
    root = require_root()
    arc_dir = resolve_arc_dir(root, args.id)
    update_status(arc_dir, args.new_status, note=args.note, reason=args.reason)
    rebuild_index(root)
    err(f"{arc_dir.name} -> {args.new_status}.")


def cmd_abandon(args: argparse.Namespace) -> None:
    root = require_root()
    arc_dir = resolve_arc_dir(root, args.id)
    update_status(arc_dir, "abandoned", reason=args.reason)
    rebuild_index(root)
    err(f"abandoned {arc_dir.name}.")


def cmd_delete(args: argparse.Namespace) -> None:
    root = require_root()
    arc_dir = resolve_arc_dir(root, args.id)
    name = arc_dir.name
    shutil.rmtree(arc_dir)
    rebuild_index(root)
    err(f"deleted {name}.")


def cmd_touch(args: argparse.Namespace) -> None:
    root = require_root()
    arc_dir = resolve_arc_dir(root, args.id)
    _migrate_legacy_log(arc_dir)
    fm, history, log_body = parse_meta(arc_dir)
    fm["last_active_at"] = now_iso()
    write_meta(arc_dir, fm, history, log_body=log_body)
    rebuild_index(root)


def cmd_log(args: argparse.Namespace) -> None:
    root = require_root()
    arc_dir = resolve_arc_dir(root, args.id)
    text = " ".join(args.text).strip()
    if not text:
        die("log message required.")
    _migrate_legacy_log(arc_dir)
    fm, history, log_body = parse_meta(arc_dir)
    entry = f"- **[{now_human()}]** {text}"
    if log_body.strip():
        log_body = log_body.rstrip() + "\n\n" + entry
    else:
        log_body = entry
    fm["last_active_at"] = now_iso()
    write_meta(arc_dir, fm, history, log_body=log_body)
    rebuild_index(root)


def cmd_output(args: argparse.Namespace) -> None:
    root = require_root()
    arc_dir = resolve_arc_dir(root, args.id)
    name = slugify_brief(args.name, max_words=3)
    stamp = dt.datetime.now().strftime("%y%m%d_%H%M")
    out_dir = arc_dir / "output" / f"{stamp}_{name}"
    if out_dir.exists():
        stamp = dt.datetime.now().strftime("%y%m%d_%H%M%S")
        out_dir = arc_dir / "output" / f"{stamp}_{name}"
    out_dir.mkdir(parents=True)
    # Producing an experiment output is activity: keep last_active_at honest so
    # a long-running arc is not flagged stale by the index.
    fm, history, log_body = parse_meta(arc_dir)
    fm["last_active_at"] = now_iso()
    write_meta(arc_dir, fm, history, log_body=log_body)
    rebuild_index(root)
    print(out_dir)


def cmd_list(args: argparse.Namespace) -> None:
    # Rebuild first: hints depend on files the agent writes directly (objective,
    # plan, handoff) and on wall-clock staleness, so a cached index lies.
    root = require_root()
    rebuild_index(root)
    idx = root / ARCS_DIRNAME / "index.md"
    sys.stdout.write(idx.read_text(encoding="utf-8"))


def cmd_cd(args: argparse.Namespace) -> None:
    root = require_root()
    arc_dir = find_arc_dir(root, args.id)
    print(arc_dir)


def cmd_rebuild(args: argparse.Namespace) -> None:
    root = require_root()
    rebuild_index(root)
    err("rebuilt index.md.")


def cmd_resolve(args: argparse.Namespace) -> None:
    root = require_root()
    arc_dir = find_arc_dir(root, args.id)
    print(arc_dir)


# ---------- main ----------

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="arc", description="Arc — task management protocol")
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("init", help="Initialize arcs/ in current directory")
    sp.set_defaults(func=cmd_init)

    sp = sub.add_parser("new", help="Create a new arc")
    sp.add_argument(
        "brief",
        nargs="+",
        help="Brief description (≤5 words after slugify). Optional suffix: track <name>",
    )
    sp.add_argument("--actor", default=None)
    sp.set_defaults(func=cmd_new)

    sp = sub.add_parser("spawn", help="Create a child arc (parent = cwd or --parent)")
    sp.add_argument("brief", nargs="+")
    sp.add_argument("--parent", default=None, help="Parent arc id (7-char or full name)")
    sp.add_argument("--actor", default=None)
    sp.set_defaults(func=cmd_spawn)

    sp = sub.add_parser("pause", help="Pause an arc")
    sp.add_argument("id", nargs="?", default=None)
    sp.add_argument("--note", required=True)
    sp.set_defaults(func=cmd_pause)

    sp = sub.add_parser("resume", help="Resume an arc (echoes canonical path)")
    sp.add_argument("id")
    sp.set_defaults(func=cmd_resume)

    sp = sub.add_parser("status", help="Set arc status")
    sp.add_argument("id")
    sp.add_argument("new_status", choices=STATES)
    sp.add_argument("--note", default=None)
    sp.add_argument("--reason", default=None)
    sp.set_defaults(func=cmd_status)

    sp = sub.add_parser("abandon", help="Mark arc abandoned")
    sp.add_argument("id")
    sp.add_argument("--reason", required=True)
    sp.set_defaults(func=cmd_abandon)

    sp = sub.add_parser(
        "delete",
        help="Hard-delete an arc (use abandon to preserve trace)",
    )
    sp.add_argument("id")
    sp.set_defaults(func=cmd_delete)

    sp = sub.add_parser("touch", help="Update last_active_at and rebuild index")
    sp.add_argument("id", nargs="?", default=None)
    sp.set_defaults(func=cmd_touch)

    sp = sub.add_parser("log", help="Append to ## log section in 0_meta.md")
    sp.add_argument("-i", "--id", default=None)
    sp.add_argument("text", nargs="+")
    sp.set_defaults(func=cmd_log)

    sp = sub.add_parser("output", help="Create output/<YYMMDD_HHMM>_<name>/ and echo path")
    sp.add_argument("-i", "--id", default=None)
    sp.add_argument("name")
    sp.set_defaults(func=cmd_output)

    sp = sub.add_parser("list", help="Print index.md to stdout")
    sp.set_defaults(func=cmd_list)

    sp = sub.add_parser("cd", help="Echo canonical path of arc (use: cd $(arc cd <id>))")
    sp.add_argument("id")
    sp.set_defaults(func=cmd_cd)

    sp = sub.add_parser("rebuild", help="Rebuild index.md from each arc's 0_meta.md")
    sp.set_defaults(func=cmd_rebuild)

    sp = sub.add_parser("_resolve", help="Resolve id to canonical path (internal)")
    sp.add_argument("id")
    sp.set_defaults(func=cmd_resolve)

    return p


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
