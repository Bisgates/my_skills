#!/usr/bin/env bash
# install [--no-prune] [--no-hooks] [<skill> ...] — create/refresh symlinks
# from <repo>/<name> to ~/.claude/skills/<name>, ~/.codex/skills/<name>, and
# ~/.gemini/antigravity/skills/<name>.
#
# With no skill args, installs every manifest entry plus dependency closure.
# With args, installs only the named skills plus their dependency closure.
# Idempotent. Skips path conflicts (real dirs / wrong-target symlinks) and
# reprints them as a problem list at the end, because a lone WARN in a 60-line
# link log is how a machine ends up quietly missing half its skills.
#
# Also (unless disabled):
#   --no-prune  keep symlinks that point at a repo dir which no longer exists.
#               Pruning is on by default: a dangling link into the repo is a
#               skill that was deleted or renamed, and agent runtimes list it
#               as a broken skill forever otherwise. Links pointing outside the
#               repo are never touched.
#   --no-hooks  skip installing the repo's post-merge/post-checkout/post-rewrite
#               git hooks. The hooks re-run this script after any `git pull`, so
#               a plain pull (not just bin/sync) still refreshes the symlinks.

set -euo pipefail

REPO="$(cd "$(dirname "$0")/../.." && pwd)"
MANIFEST="$REPO/manifest.txt"
TARGETS=(
  "$HOME/.claude/skills"
  "$HOME/.codex/skills"
  "$HOME/.gemini/antigravity/skills"
)

# shellcheck source=/dev/null
source "$REPO/skill-mgmt/bin/common"
skill_mgmt_capture_git_state

do_prune=1
do_hooks=1
requested=()
for arg in "$@"; do
  case "$arg" in
    --no-prune) do_prune=0 ;;
    --no-hooks) do_hooks=0 ;;
    -*) echo "install: unknown option '$arg'" >&2; exit 2 ;;
    *) requested+=("$arg") ;;
  esac
done

if [[ ! -f "$MANIFEST" ]]; then
  echo "install: manifest not found: $MANIFEST" >&2
  exit 1
fi

# Ensure target parent dirs exist.
for t in "${TARGETS[@]}"; do
  mkdir -p "$t"
done

linked=0
skipped=0
pruned=0
problems=()

problem() {
  echo "WARN: $1" >&2
  problems+=("$1")
}

# link_skill <rel-path-in-repo> <link-basename>
link_skill() {
  local rel="$1" name="$2" src t link current
  src="$REPO/$rel"

  if [[ ! -d "$src" ]]; then
    problem "$rel resolved but $src is not a directory; not linked anywhere"
    return 0
  fi

  if ! skill_mgmt_check_codex_desc_length "$rel"; then
    problems+=("$rel description exceeds the codex 1024-char cap; codex drops it")
  fi

  for t in "${TARGETS[@]}"; do
    link="$t/$name"
    if [[ -L "$link" ]]; then
      current="$(readlink "$link")"
      if [[ "$current" == "$src" ]]; then
        skipped=$((skipped + 1))
      else
        problem "$link is a symlink to $current (expected $src); left alone"
      fi
    elif [[ -e "$link" ]]; then
      problem "$link exists and is not a symlink; left alone — use bin/adopt"
    else
      ln -s "$src" "$link"
      echo "linked: $link -> $src"
      linked=$((linked + 1))
    fi
  done
}

# Remove symlinks that point into this repo at a path that no longer exists —
# deleted or renamed skills. Anything pointing outside the repo belongs to the
# user, not to us.
prune_dead_links() {
  local t link target
  for t in "${TARGETS[@]}"; do
    [[ -d "$t" ]] || continue
    for link in "$t"/*; do
      [[ -L "$link" ]] || continue
      [[ -e "$link" ]] && continue
      target="$(readlink "$link")"
      [[ "$target" == "$REPO/"* ]] || continue
      rm "$link"
      echo "pruned: $link (dead -> $target)"
      pruned=$((pruned + 1))
    done
  done
}

# `git pull` does not refresh symlinks by itself, so a machine whose repo is
# current can still be missing every skill added since its last bin/install.
# These hooks close that gap: post-merge covers fast-forward pulls, post-rewrite
# covers rebasing pulls, post-checkout covers branch switches.
HOOK_MARKER="# managed by skill-mgmt/bin/install"
install_git_hooks() {
  local hooks_dir hook path
  git -C "$REPO" rev-parse --is-inside-work-tree > /dev/null 2>&1 || return 0
  hooks_dir="$(git -C "$REPO" rev-parse --git-path hooks)"
  [[ "$hooks_dir" == /* ]] || hooks_dir="$REPO/$hooks_dir"
  mkdir -p "$hooks_dir"

  for hook in post-merge post-rewrite post-checkout; do
    path="$hooks_dir/$hook"
    if [[ -e "$path" ]] && ! grep -qF "$HOOK_MARKER" "$path"; then
      problem "$path exists and was not written by skill-mgmt; left alone"
      continue
    fi
    {
      echo '#!/bin/sh'
      echo "$HOOK_MARKER — refresh skill symlinks after a git update."
      echo '# Additive only (--no-prune): a rebase passes through transient states'
      echo '# where a skill dir is briefly absent, and deleting links there is wrong.'
      if [[ "$hook" == post-checkout ]]; then
        echo '# args are (prev, new, is_branch_checkout); ignore file checkouts.'
        echo '[ "$3" = 1 ] || exit 0'
      fi
      echo 'repo=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0'
      echo '[ -x "$repo/skill-mgmt/bin/install" ] || exit 0'
      echo 'SKILL_MGMT_AUTOCOMMIT=0 "$repo/skill-mgmt/bin/install" --no-prune --no-hooks || true'
    } > "$path"
    chmod +x "$path"
  done
}

if [[ "${#requested[@]}" -eq 0 ]]; then
  while IFS= read -r name || [[ -n "$name" ]]; do
    requested+=("$name")
  done < <(skill_mgmt_manifest_skills "$MANIFEST")
fi

if [[ "${#requested[@]}" -eq 0 ]]; then
  echo "install: no skills requested" >&2
  exit 1
fi

skill_mgmt_resolve_install_set "${requested[@]}"
for name in ${skill_mgmt_install_names[@]+"${skill_mgmt_install_names[@]}"}; do
  link_skill "$name" "$name"
done
if [[ "${#skill_mgmt_install_names[@]}" -ne "${#requested[@]}" ]]; then
  echo "install: requested ${#requested[@]}, resolved ${#skill_mgmt_install_names[@]} including dependencies"
fi

if [[ "$do_prune" -eq 1 ]]; then prune_dead_links; fi
if [[ "$do_hooks" -eq 1 ]]; then install_git_hooks; fi

echo "install: $linked new, $skipped already-correct, $pruned pruned, ${#problems[@]} problems"
if [[ "${#problems[@]}" -gt 0 ]]; then
  echo "install: problems needing a decision:"
  for p in "${problems[@]}"; do
    echo "  - $p"
  done
fi

skill_mgmt_auto_commit_push "refresh skill installs"
