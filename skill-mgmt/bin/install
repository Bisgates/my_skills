#!/usr/bin/env bash
# install [<skill> ...] — create/refresh symlinks from <repo>/<name> to
# ~/.claude/skills/<name>, ~/.codex/skills/<name>, and
# ~/.gemini/antigravity/skills/<name>.
#
# With no args, installs every manifest entry plus dependency closure, then
# every generated knowledge skill under <repo>/wisdom/. With args, installs
# only the named skills plus their dependency closure; a name with no
# top-level dir falls back to <repo>/wisdom/<name>. Idempotent. Skips path
# conflicts (real dirs / wrong-target symlinks) with a warning.

set -euo pipefail

REPO="$(cd "$(dirname "$0")/../.." && pwd)"
MANIFEST="$REPO/manifest.txt"
WISDOM_DIR="$REPO/wisdom"
TARGETS=(
  "$HOME/.claude/skills"
  "$HOME/.codex/skills"
  "$HOME/.gemini/antigravity/skills"
)

# shellcheck source=/dev/null
source "$REPO/skill-mgmt/bin/common"
skill_mgmt_capture_git_state

if [[ ! -f "$MANIFEST" ]]; then
  echo "install: manifest not found: $MANIFEST" >&2
  exit 1
fi

# Ensure target parent dirs exist.
for t in "${TARGETS[@]}"; do
  mkdir -p "$t"
done

linked=0
skipped=0
warned=0

# link_skill <rel-path-in-repo> <link-basename>
link_skill() {
  local rel="$1" name="$2" src t link current
  src="$REPO/$rel"

  if [[ ! -d "$src" ]]; then
    echo "WARN: $rel resolved but $src not a directory; skipping" >&2
    warned=$((warned + 1))
    return 0
  fi

  if ! skill_mgmt_check_codex_desc_length "$rel"; then
    warned=$((warned + 1))
  fi

  for t in "${TARGETS[@]}"; do
    link="$t/$name"
    if [[ -L "$link" ]]; then
      current="$(readlink "$link")"
      if [[ "$current" == "$src" ]]; then
        skipped=$((skipped + 1))
      else
        echo "WARN: $link is a symlink to $current (expected $src); skipping" >&2
        warned=$((warned + 1))
      fi
    elif [[ -e "$link" ]]; then
      echo "WARN: $link exists and is not a symlink; skipping. Use bin/adopt." >&2
      warned=$((warned + 1))
    else
      ln -s "$src" "$link"
      echo "linked: $link -> $src"
      linked=$((linked + 1))
    fi
  done
}

requested=()
wisdom_requested=()
if [[ $# -gt 0 ]]; then
  for name in "$@"; do
    if [[ ! -d "$REPO/$name" && -d "$WISDOM_DIR/$name" ]]; then
      wisdom_requested+=("$name")
    else
      requested+=("$name")
    fi
  done
else
  while IFS= read -r name || [[ -n "$name" ]]; do
    requested+=("$name")
  done < <(skill_mgmt_manifest_skills "$MANIFEST")
  if [[ -d "$WISDOM_DIR" ]]; then
    for d in "$WISDOM_DIR"/*/; do
      [[ -d "$d" ]] || continue
      wisdom_requested+=("$(basename "${d%/}")")
    done
  fi
fi

if [[ "${#requested[@]}" -eq 0 && "${#wisdom_requested[@]}" -eq 0 ]]; then
  echo "install: no skills requested" >&2
  exit 1
fi

if [[ "${#requested[@]}" -gt 0 ]]; then
  skill_mgmt_resolve_install_set "${requested[@]}"
  for name in ${skill_mgmt_install_names[@]+"${skill_mgmt_install_names[@]}"}; do
    link_skill "$name" "$name"
  done
  if [[ "${#skill_mgmt_install_names[@]}" -ne "${#requested[@]}" ]]; then
    echo "install: requested ${#requested[@]}, resolved ${#skill_mgmt_install_names[@]} including dependencies"
  fi
fi

# Wisdom skills live under <repo>/wisdom/<name> and are linked by
# basename, not via manifest.txt.
for name in ${wisdom_requested[@]+"${wisdom_requested[@]}"}; do
  if ! skill_mgmt_valid_name "$name"; then
    echo "WARN: invalid wisdom skill name '$name'; skipping" >&2
    warned=$((warned + 1))
    continue
  fi
  if [[ ! -f "$WISDOM_DIR/$name/SKILL.md" ]]; then
    echo "WARN: wisdom/$name has no SKILL.md; skipping" >&2
    warned=$((warned + 1))
    continue
  fi
  link_skill "wisdom/$name" "$name"
done

echo "install: $linked new, $skipped already-correct, $warned warnings"

skill_mgmt_auto_commit_push "refresh skill installs"
