#!/usr/bin/env bash
# common — shared helpers for skill-mgmt scripts.
# Source from scripts after setting REPO when possible.

skill_mgmt_trim() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s\n' "$value"
}

skill_mgmt_valid_name() {
  [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]]
}

skill_mgmt_contains() {
  local needle="$1"
  shift || true
  local item
  for item in "$@"; do
    [[ "$item" == "$needle" ]] && return 0
  done
  return 1
}

skill_mgmt_manifest_skills() {
  local manifest="$1"
  local raw name
  while IFS= read -r raw || [[ -n "$raw" ]]; do
    name="$(skill_mgmt_trim "$raw")"
    [[ -z "$name" ]] && continue
    [[ "$name" == \#* ]] && continue
    printf '%s\n' "$name"
  done < "$manifest"
}

skill_mgmt_skill_dependencies() {
  local skill="$1"
  local file="$REPO/$skill/SKILL.md"
  [[ -f "$file" ]] || return 0

  awk '
    function trim(s) {
      gsub(/^[ \t\047"\[]+/, "", s)
      gsub(/[ \t\047",\]]+$/, "", s)
      return s
    }
    function emit_list(s, parts, count, i, dep) {
      sub(/[ \t]+#.*/, "", s)
      count = split(s, parts, ",")
      for (i = 1; i <= count; i++) {
        dep = trim(parts[i])
        if (dep != "" && dep != "[]") print dep
      }
    }
    NR == 1 && $0 == "---" { in_fm = 1; next }
    in_fm && $0 == "---" { exit }
    in_fm {
      if ($0 ~ /^[[:space:]]*(dependencies|depends_on|requires)[[:space:]]*:/) {
        line = $0
        sub(/^[[:space:]]*(dependencies|depends_on|requires)[[:space:]]*:[[:space:]]*/, "", line)
        in_deps = 1
        if (line != "" && line != "[]" && line !~ /^[[:space:]]*#/) emit_list(line)
        next
      }
      if (in_deps && $0 ~ /^[[:space:]]*-[[:space:]]*/) {
        line = $0
        sub(/^[[:space:]]*-[[:space:]]*/, "", line)
        sub(/[[:space:]]+#.*/, "", line)
        dep = trim(line)
        if (dep != "") print dep
        next
      }
      if (in_deps && $0 ~ /^[[:space:]]*[A-Za-z_][A-Za-z0-9_-]*[[:space:]]*:/) in_deps = 0
    }
  ' "$file"
}

# codex 0.128+ refuses to load a skill whose description exceeds this many
# characters (verified empirically against the `invalid description: exceeds
# maximum length of 1024 characters` error). Keep ours under it. Claude and
# Antigravity have no comparable hard limit, but shorter descriptions are
# generally also better.
SKILL_MGMT_CODEX_DESC_MAX=1024

# Extract the YAML frontmatter `description:` value for a skill. Joins folded
# continuation lines (no leading `key:`) so multiline descriptions are measured
# correctly, matching how codex parses the value.
skill_mgmt_skill_description() {
  local skill="$1"
  local file="$REPO/$skill/SKILL.md"
  [[ -f "$file" ]] || return 0

  awk '
    NR == 1 && $0 == "---" { in_fm = 1; next }
    in_fm && $0 == "---" { if (have) print buf; exit }
    in_fm {
      if (!have && $0 ~ /^description:[[:space:]]*/) {
        buf = $0
        sub(/^description:[[:space:]]*/, "", buf)
        have = 1
        next
      }
      if (have) {
        if ($0 ~ /^[A-Za-z_][A-Za-z0-9_-]*[[:space:]]*:/) { print buf; exit }
        line = $0
        sub(/^[[:space:]]+/, "", line)
        if (line != "") buf = buf " " line
      }
    }
  ' "$file"
}

# Warn (non-fatal) if a skill's description would be silently dropped by codex.
skill_mgmt_check_codex_desc_length() {
  local skill="$1"
  local desc
  desc="$(skill_mgmt_skill_description "$skill")"
  local len="${#desc}"
  if (( len > SKILL_MGMT_CODEX_DESC_MAX )); then
    echo "WARN: $skill description is $len chars (>$SKILL_MGMT_CODEX_DESC_MAX); codex will silently drop this skill — claude/antigravity still load it" >&2
    return 1
  fi
  return 0
}

# Populated by skill_mgmt_resolve_install_set.
skill_mgmt_install_names=()
skill_mgmt_visiting_names=()

skill_mgmt_visit_install_name() {
  local name="$1"
  local parent="${2:-}"
  local src="$REPO/$name"
  local dep

  if ! skill_mgmt_valid_name "$name"; then
    echo "install: invalid skill name '$name'" >&2
    return 1
  fi

  if [[ "${#skill_mgmt_install_names[@]}" -gt 0 ]] && skill_mgmt_contains "$name" "${skill_mgmt_install_names[@]}"; then
    return 0
  fi

  if [[ "${#skill_mgmt_visiting_names[@]}" -gt 0 ]] && skill_mgmt_contains "$name" "${skill_mgmt_visiting_names[@]}"; then
    echo "install: dependency cycle detected at '$name'" >&2
    return 1
  fi

  if [[ ! -d "$src" ]]; then
    if [[ -n "$parent" ]]; then
      echo "install: '$parent' depends on '$name', but $src is not a directory" >&2
      return 1
    fi
    echo "WARN: $name requested but $src not a directory; skipping" >&2
    return 0
  fi

  skill_mgmt_visiting_names+=("$name")
  while IFS= read -r dep || [[ -n "$dep" ]]; do
    dep="$(skill_mgmt_trim "$dep")"
    [[ -z "$dep" ]] && continue
    if ! skill_mgmt_visit_install_name "$dep" "$name"; then
      return 1
    fi
  done < <(skill_mgmt_skill_dependencies "$name")
  unset 'skill_mgmt_visiting_names[${#skill_mgmt_visiting_names[@]}-1]'

  if [[ "${#skill_mgmt_install_names[@]}" -eq 0 ]] || ! skill_mgmt_contains "$name" "${skill_mgmt_install_names[@]}"; then
    skill_mgmt_install_names+=("$name")
  fi
}

skill_mgmt_resolve_install_set() {
  skill_mgmt_install_names=()
  skill_mgmt_visiting_names=()
  local name
  for name in "$@"; do
    skill_mgmt_visit_install_name "$name" || return 1
  done
}

skill_mgmt_autocommit_enabled() {
  case "${SKILL_MGMT_AUTOCOMMIT:-1}" in
    0|false|FALSE|no|NO|off|OFF) return 1 ;;
    *) return 0 ;;
  esac
}

skill_mgmt_autopush_enabled() {
  case "${SKILL_MGMT_AUTOPUSH:-1}" in
    0|false|FALSE|no|NO|off|OFF) return 1 ;;
    *) return 0 ;;
  esac
}

skill_mgmt_git_state_captured=0
skill_mgmt_git_dirty_at_start=0
skill_mgmt_git_dirty_paths_at_start=()

skill_mgmt_capture_git_state() {
  skill_mgmt_git_state_captured=1
  skill_mgmt_git_dirty_at_start=0
  skill_mgmt_git_dirty_paths_at_start=()
  if ! git -C "$REPO" rev-parse --is-inside-work-tree > /dev/null 2>&1; then
    return 0
  fi
  local porcelain
  porcelain="$(git -C "$REPO" status --porcelain)"
  [[ -z "$porcelain" ]] && return 0
  skill_mgmt_git_dirty_at_start=1
  # Each line: "XY path" or "XY old -> new" for renames. Record both old and new for renames.
  local line path old new
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    path="${line:3}"
    if [[ "$path" == *" -> "* ]]; then
      old="${path%% -> *}"
      new="${path##* -> }"
      skill_mgmt_git_dirty_paths_at_start+=("$old" "$new")
    else
      skill_mgmt_git_dirty_paths_at_start+=("$path")
    fi
  done <<< "$porcelain"
}

# Usage: skill_mgmt_auto_commit_push <message> [<path> ...]
# Path-scoped commit. If paths are passed, only those are staged; other dirty
# files in the repo (e.g. unrelated in-progress edits to other skills) are
# left alone. Refuses to commit only on real conflicts:
#   (a) any target path was already dirty before this op started, or
#   (b) repo is mid-merge / mid-rebase / mid-cherry-pick / mid-revert.
# With no paths (legacy), falls back to "git add -A and refuse if repo was
# dirty at start" so old callers don't silently change behavior.
skill_mgmt_auto_commit_push() {
  local message="$1"
  shift || true
  local -a paths=("$@")

  if ! skill_mgmt_autocommit_enabled; then
    echo "auto-commit: disabled by SKILL_MGMT_AUTOCOMMIT"
    return 0
  fi

  if [[ "$skill_mgmt_git_state_captured" -ne 1 ]]; then
    skill_mgmt_capture_git_state
  fi

  if ! git -C "$REPO" rev-parse --is-inside-work-tree > /dev/null 2>&1; then
    echo "auto-commit: $REPO is not a git repo; skipped" >&2
    return 0
  fi

  if [[ -z "$(git -C "$REPO" status --porcelain)" ]]; then
    echo "auto-commit: no repo changes"
    return 0
  fi

  local git_dir
  git_dir="$(git -C "$REPO" rev-parse --git-dir)"
  if [[ -e "$git_dir/MERGE_HEAD" || -e "$git_dir/CHERRY_PICK_HEAD" || -e "$git_dir/REVERT_HEAD" \
        || -d "$git_dir/rebase-apply" || -d "$git_dir/rebase-merge" ]]; then
    echo "auto-commit: skipped, repo is mid-merge/rebase/cherry-pick — resolve first" >&2
    echo "             review: cd $REPO && git status --short" >&2
    return 0
  fi

  if [[ "${#paths[@]}" -eq 0 ]]; then
    # Legacy: no paths specified → keep old global guard.
    if [[ "$skill_mgmt_git_dirty_at_start" -eq 1 ]]; then
      echo "auto-commit: skipped because repo was already dirty and no paths were specified" >&2
      echo "             review: cd $REPO && git status --short" >&2
      return 0
    fi
    git -C "$REPO" add -A
  else
    # Path-scoped: refuse only if any target path was already dirty pre-op.
    local -a conflicting=()
    local p dirty
    for p in "${paths[@]}"; do
      for dirty in "${skill_mgmt_git_dirty_paths_at_start[@]:-}"; do
        [[ -z "$dirty" ]] && continue
        if [[ "$dirty" == "$p" || "$dirty" == "$p/"* || "$p" == "$dirty/"* ]]; then
          conflicting+=("$p (prior uncommitted: $dirty)")
          break
        fi
      done
    done
    if [[ "${#conflicting[@]}" -gt 0 ]]; then
      echo "auto-commit: skipped, target path(s) had prior uncommitted changes:" >&2
      for p in "${conflicting[@]}"; do
        echo "             - $p" >&2
      done
      echo "             resolve those manually, then re-run." >&2
      return 0
    fi
    git -C "$REPO" add -- "${paths[@]}"
  fi

  if git -C "$REPO" diff --cached --quiet; then
    echo "auto-commit: no staged changes"
    return 0
  fi

  echo "auto-commit: committing repo changes"
  git -C "$REPO" commit -m "$message"

  if skill_mgmt_autopush_enabled; then
    echo "auto-push: rebasing then pushing"
    git -C "$REPO" pull --rebase
    git -C "$REPO" push
  else
    echo "auto-push: disabled by SKILL_MGMT_AUTOPUSH"
  fi
}
