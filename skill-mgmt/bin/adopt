#!/usr/bin/env bash
# adopt <name> [--from claude|codex|antigravity] — move an existing real-directory
# skill at ~/.claude/skills/<name>, ~/.codex/skills/<name>, or
# ~/.gemini/antigravity/skills/<name> into <repo>/<name>, append to manifest,
# and refresh symlinks via install.
#
# Refuses if multiple agent dirs contain diverged copies unless --from is given.

set -euo pipefail

REPO="$(cd "$(dirname "$0")/../.." && pwd)"
MANIFEST="$REPO/manifest.txt"
# shellcheck source=/dev/null
source "$REPO/skill-mgmt/bin/common"
skill_mgmt_capture_git_state

usage() {
  echo "usage: adopt <name> [--from claude|codex|antigravity]" >&2
  exit 2
}

[[ $# -ge 1 ]] || usage
name="$1"
shift
from=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --from)
      from="${2:-}"
      [[ "$from" == "claude" || "$from" == "codex" || "$from" == "antigravity" ]] || usage
      shift 2
      ;;
    *) usage ;;
  esac
done

claude_path="$HOME/.claude/skills/$name"
codex_path="$HOME/.codex/skills/$name"
antigravity_path="$HOME/.gemini/antigravity/skills/$name"

is_real_dir() { [[ -d "$1" && ! -L "$1" ]]; }

all_identical_dirs() {
  local first="$1"
  shift
  local d
  for d in "$@"; do
    if ! diff -rq "$first" "$d" > /dev/null 2>&1; then
      return 1
    fi
  done
  return 0
}

# Collect paths that are real (non-symlink) directories.
declare -a real_paths=()
is_real_dir "$claude_path" && real_paths+=("$claude_path")
is_real_dir "$codex_path" && real_paths+=("$codex_path")
is_real_dir "$antigravity_path" && real_paths+=("$antigravity_path")

if [[ "${#real_paths[@]}" -eq 0 ]]; then
  echo "adopt: no real directory found at $claude_path, $codex_path, or $antigravity_path" >&2
  exit 1
fi

if [[ -e "$REPO/$name" ]]; then
  echo "adopt: $REPO/$name already exists; nothing to adopt" >&2
  exit 1
fi

src=""
if [[ -n "$from" ]]; then
  case "$from" in
    claude) src="$claude_path" ;;
    codex) src="$codex_path" ;;
    antigravity) src="$antigravity_path" ;;
  esac
  if ! is_real_dir "$src"; then
    echo "adopt: expected a real directory for --from $from at $src" >&2
    exit 1
  fi
elif [[ "${#real_paths[@]}" -eq 1 ]]; then
  src="${real_paths[0]}"
else
  if all_identical_dirs "${real_paths[@]}"; then
    echo "adopt: $name identical in all agent dirs; preferring claude > codex > antigravity"
    if is_real_dir "$claude_path"; then
      src="$claude_path"
    elif is_real_dir "$codex_path"; then
      src="$codex_path"
    else
      src="$antigravity_path"
    fi
  else
    echo "adopt: $name differs between agent dirs" >&2
    echo "       compare with e.g.: diff -rq $claude_path $codex_path" >&2
    echo "       then re-run with: --from claude|codex|antigravity" >&2
    exit 1
  fi
fi

echo "adopt: moving $src -> $REPO/$name"
mv "$src" "$REPO/$name"

# Any other remaining real dirs at agent paths would shadow install symlinks — back them up.
for candidate in "$claude_path" "$codex_path" "$antigravity_path"; do
  if [[ "$candidate" == "$src" ]]; then
    continue
  fi
  if is_real_dir "$candidate"; then
    bak="${candidate}.adopted-bak-$(date +%Y%m%d_%H%M%S)"
    echo "adopt: other location $candidate is still a real dir; renaming to $bak" >&2
    mv "$candidate" "$bak"
  fi
done

# Append to manifest if not already there
if ! grep -qxF "$name" "$MANIFEST" 2>/dev/null; then
  echo "$name" >> "$MANIFEST"
  echo "adopt: appended '$name' to $MANIFEST"
fi

SKILL_MGMT_AUTOCOMMIT=0 "$REPO/skill-mgmt/bin/install"

skill_mgmt_auto_commit_push "adopt $name" "$name" "manifest.txt"

cat <<EOF

✓ adopted: $name

By default this script already auto-committed and pushed the new $name/ and manifest.txt paths (other dirty files in this repo were left alone).
EOF
